# Flutter MVP 默认使用本地 ASR 和 MockAiProcessingService，不读取本文件。
# 腾讯云长期密钥只配置到 server/tencent_asr_proxy 的部署环境。
# 禁止把任何真实密钥、令牌或 .env 提交到 Git。
AI_API_BASE_URL=https://your-server.example.com
AI_API_KEY=replace_me
CLOUD_ASR_PROXY_URL=wss://your-server.example.com/v1/asr/tencent/realtime
CLOUD_ASR_PROXY_TOKEN=replace_with_a_revocable_proxy_token
